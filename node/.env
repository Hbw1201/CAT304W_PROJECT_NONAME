# DashScope API Configuration
# Copy this file to .env and fill in your actual API key

# Required: Your Alibaba Cloud DashScope API Key
# Get it from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# Optional: Model name (default: qwen-plus)
# Available models: qwen-plus, qwen-turbo, qwen-max
DASHSCOPE_MODEL=qwen-plus

# Optional: Service port (default: 3000)
# PORT=3000
# NODE_CHAT_PORT=3000
